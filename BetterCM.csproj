<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Version>1.5.0</Version>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <FileVersion>$(Version).0</FileVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsAppSDKBootstrapInitialize>false</WindowsAppSDKBootstrapInitialize>
    <WindowsAppSdkDeploymentManagerInitialize>false</WindowsAppSdkDeploymentManagerInitialize>
    <ApplicationManifest>$(BaseIntermediateOutputPath)BetterCM.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\BetterCM.ico</ApplicationIcon>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <DefaultItemExcludes>$(DefaultItemExcludes);Tests\**;Backups\**;artifacts\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="1.8.260708001" />
    <Compile Remove="Tests\**;Backups\**;artifacts\**" />
    <Content Remove="Tests\**;Backups\**;artifacts\**" />
    <Resource Remove="Tests\**;Backups\**;artifacts\**" />
    <None Remove="Tests\**;Backups\**;artifacts\**" />
    <EmbeddedResource Include="Assets\BetterCM.ico" />
    <Content Include="config.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <Target Name="GenerateVersionedManifest" BeforeTargets="PrepareForBuild">
    <PropertyGroup>
      <_ManifestText>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/app.manifest').Replace('__APP_VERSION__', '$(FileVersion)'))</_ManifestText>
    </PropertyGroup>
    <MakeDir Directories="$(BaseIntermediateOutputPath)" />
    <WriteLinesToFile File="$(ApplicationManifest)" Lines="$(_ManifestText)" Overwrite="true" Encoding="UTF-8" WriteOnlyWhenDifferent="true" />
  </Target>
</Project>
