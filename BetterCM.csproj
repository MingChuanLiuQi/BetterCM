<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <FileVersion>$(Version).0</FileVersion>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSdkDeploymentManagerInitialize>false</WindowsAppSdkDeploymentManagerInitialize>
    <ApplicationManifest>$(BaseIntermediateOutputPath)BetterCM.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\BetterCM.ico</ApplicationIcon>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <ItemGroup Condition="'$(BetterCMEnableQA)' != 'true'">
    <Compile Remove="Services\*Checks.cs;Services\SelfTests.cs;App.Diagnostics.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" />
    <EmbeddedResource Include="Assets\BetterCM.ico" />
    <Content Include="config.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <Target Name="GenerateVersionedManifest" BeforeTargets="PrepareForBuild">
    <PropertyGroup>
      <_ManifestText>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/app.manifest').Replace('__APP_VERSION__', '$(FileVersion)'))</_ManifestText>
    </PropertyGroup>
    <MakeDir Directories="$(BaseIntermediateOutputPath)" />
    <WriteLinesToFile File="$(ApplicationManifest)" Lines="$(_ManifestText)" Overwrite="true" Encoding="UTF-8" WriteOnlyWhenDifferent="true" />
  </Target>
</Project>
