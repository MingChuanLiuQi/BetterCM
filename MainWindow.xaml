<Window x:Class="BetterCM.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:services="clr-namespace:BetterCM.Services" Style="{StaticResource {x:Type Window}}" Title="BetterCM · 设置" Width="960" Height="740" MinWidth="880" MinHeight="590" WindowStartupLocation="CenterScreen" Closing="Window_Closing">
  <Grid Margin="26">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="BetterCM" FontSize="27" FontWeight="SemiBold" />
        <TextBlock Text="好看的右键菜单，也可以一步到位。" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" />
      </StackPanel>
      <Border Grid.Column="1" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" VerticalAlignment="Center">
        <TextBlock Text="{x:Static services:AppInfo.Version}" Foreground="{DynamicResource MutedBrush}" />
      </Border>
    </Grid>
    <TabControl Grid.Row="1">
      <TabItem Header="常规">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="4,0,14,0">
            <Border Background="{DynamicResource CardBg}" CornerRadius="9" Padding="20" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="右键与启动" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8" />
                <CheckBox x:Name="ReplaceMenu" Content="在资源管理器（含导航栏）和桌面使用 BetterCM" />
                <TextBlock Text="普通右键始终使用 BetterCM。按下前按住 Shift，可使用原生菜单或原生右键拖动。" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" />
                <CheckBox x:Name="StartWithWindows" Content="登录 Windows 后自动启动，静默驻留托盘" />
                <TextBlock Text="关闭此设置窗口后仍在托盘运行；从托盘菜单选择“退出”才会结束程序。" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" />
                <Grid Margin="0,17,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="呼出快捷键" VerticalAlignment="Center" />
                  <TextBox x:Name="HotkeyText" Grid.Column="1" TextChanged="Hotkey_Changed" ToolTip="例如 Alt+X 或 Ctrl+Alt+M" />
                </Grid>
                <TextBlock x:Name="HotkeyValidation" FontSize="12" TextWrapping="Wrap" Margin="140,7,0,0" />
                <TextBlock x:Name="InputStatus" Foreground="{DynamicResource AccentBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,10,0,0" />
              </StackPanel>
            </Border>
            <Border Background="{DynamicResource CardBg}" CornerRadius="9" Padding="20">
              <StackPanel>
                <TextBlock Text="菜单体验" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8" />
                <CheckBox x:Name="ClassicOption" Content="忠实呈现经典右键菜单（默认）" Checked="Classic_Changed" Unchecked="Classic_Changed" />
                <TextBlock Text="直接使用 Windows 的项目顺序、分隔线和子菜单。此模式不加入内置或自定义动作，也不折叠、隐藏或重新固定系统项目；旧增强配置保留供手动切换。" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />
                <CheckBox x:Name="ShellActions" Content="显示系统与第三方右键项目" />
                <CheckBox x:Name="FileDetails" Content="显示来源与文件大小（完整路径悬停名称查看）" />
                <CheckBox x:Name="Notifications" Content="操作完成后显示托盘提示" />
                <CheckBox x:Name="ShowMoreOption" Content="使用“显示更多项目”折叠非常用动作" />
                <TextBlock Text="取消勾选后，首次打开即显示非常用动作及分组入口，没有二次展开。" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
                <CheckBox x:Name="CompactOption" Content="小尺寸菜单（紧凑行高，关闭搜索，保留分组）" Margin="0,8,0,0" />
                <TextBlock Text="小尺寸模式直接展示全部一级项目。两种尺寸均保留动作分组，悬停或点击后向侧边展开子菜单；只有“显示更多项目”在原菜单向下展开。" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" />
                <Grid Margin="0,14,0,0" IsEnabled="{Binding ElementName=ShowMoreOption, Path=IsChecked}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="65" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="更多项目悬停延时" VerticalAlignment="Center" />
                  <Slider x:Name="MoreDelay" Grid.Column="1" Minimum="80" Maximum="600" TickFrequency="20" IsSnapToTickEnabled="True" />
                  <TextBlock Grid.Column="2" Text="{Binding ElementName=MoreDelay, Path=Value, StringFormat={}{0:0} ms}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Text="默认 180 ms。短暂停留后在原菜单向下展开，点击可立即展开。" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
                <Grid Margin="0,14,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="65" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="侧边子菜单悬停延时" VerticalAlignment="Center" />
                  <Slider x:Name="SubmenuDelay" Grid.Column="1" Minimum="80" Maximum="600" TickFrequency="20" IsSnapToTickEnabled="True" />
                  <TextBlock Grid.Column="2" Text="{Binding ElementName=SubmenuDelay, Path=Value, StringFormat={}{0:0} ms}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Text="两种尺寸均适用。移动到另一分组后等待该延时切换；点击分组可立即打开。" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="外观与动效">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="4,0,14,0">
            <TextBlock Text="外观与动效" FontSize="23" FontWeight="SemiBold" Margin="0,0,0,5" />
            <TextBlock Text="柔和的系统材质，配上你习惯的菜单节奏。" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,18" />
            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="窗口材质" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,14" />
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <TextBlock Text="外观主题" VerticalAlignment="Center" />
                  <ComboBox x:Name="ThemeChoice" Grid.Column="1" Height="34">
                    <ComboBoxItem Content="跟随 Windows" Tag="system" />
                    <ComboBoxItem Content="深色" Tag="dark" />
                    <ComboBoxItem Content="浅色" Tag="light" />
                  </ComboBox>
                  <TextBlock Grid.Row="1" Text="背景材质" VerticalAlignment="Center" Margin="0,12,0,0" />
                  <ComboBox x:Name="MaterialChoice" Grid.Row="1" Grid.Column="1" Height="34" Margin="0,12,0,0">
                    <ComboBoxItem Content="Mica · 加深云母" Tag="mica" />
                    <ComboBoxItem Content="Acrylic · 亚克力" Tag="acrylic" />
                    <ComboBoxItem Content="纯色" Tag="solid" />
                  </ComboBox>
                </Grid>
                <TextBlock Text="云母柔和地融合壁纸颜色；亚克力呈现背景模糊。关闭 Windows 透明效果或启用高对比度时，自动使用纯色。" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="菜单动画" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,4" />
                <CheckBox x:Name="Animations" Content="启用菜单动画" />
                <Grid Margin="0,8,0,0" IsEnabled="{Binding ElementName=Animations, Path=IsChecked}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="打开" Margin="0,0,0,8" />
                    <ComboBox x:Name="OpenStyle" Height="34">
                      <ComboBoxItem Content="无动画" Tag="none" />
                      <ComboBoxItem Content="淡入" Tag="fade" />
                      <ComboBoxItem Content="轻滑动" Tag="slide" />
                      <ComboBoxItem Content="缩放" Tag="zoom" />
                      <ComboBoxItem Content="淡入 + 轻滑动" Tag="fade-slide" />
                      <ComboBoxItem Content="淡入 + 缩放" Tag="fade-zoom" />
                    </ComboBox>
                    <Grid Margin="0,12,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="62" />
                      </Grid.ColumnDefinitions>
                      <Slider x:Name="OpenDuration" Minimum="60" Maximum="400" TickFrequency="10" IsSnapToTickEnabled="True" />
                      <TextBlock Grid.Column="1" Text="{Binding ElementName=OpenDuration, Path=Value, StringFormat={}{0:0} ms}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="关闭" Margin="0,0,0,8" />
                    <ComboBox x:Name="CloseStyle" Height="34">
                      <ComboBoxItem Content="无动画" Tag="none" />
                      <ComboBoxItem Content="淡出" Tag="fade" />
                      <ComboBoxItem Content="轻滑动" Tag="slide" />
                      <ComboBoxItem Content="缩放" Tag="zoom" />
                      <ComboBoxItem Content="淡出 + 轻滑动" Tag="fade-slide" />
                      <ComboBoxItem Content="淡出 + 缩放" Tag="fade-zoom" />
                    </ComboBox>
                    <Grid Margin="0,12,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="62" />
                      </Grid.ColumnDefinitions>
                      <Slider x:Name="CloseDuration" Minimum="60" Maximum="400" TickFrequency="10" IsSnapToTickEnabled="True" />
                      <TextBlock Grid.Column="1" Text="{Binding ElementName=CloseDuration, Path=Value, StringFormat={}{0:0} ms}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                  </StackPanel>
                </Grid>
                <Grid Margin="0,20,0,0" IsEnabled="{Binding ElementName=Animations, Path=IsChecked}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="65" />
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="34" />
                    <RowDefinition Height="34" />
                    <RowDefinition Height="44" />
                  </Grid.RowDefinitions>
                  <TextBlock Text="滑动距离" VerticalAlignment="Center" />
                  <Slider x:Name="MotionDistance" Grid.Column="1" Minimum="2" Maximum="32" TickFrequency="1" IsSnapToTickEnabled="True" />
                  <TextBlock Grid.Column="2" Text="{Binding ElementName=MotionDistance, Path=Value, StringFormat={}{0:0} DIP}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                  <TextBlock Grid.Row="1" Text="缩放起点" VerticalAlignment="Center" />
                  <Slider x:Name="MotionScale" Grid.Row="1" Grid.Column="1" Minimum="90" Maximum="99" TickFrequency="1" IsSnapToTickEnabled="True" />
                  <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding ElementName=MotionScale, Path=Value, StringFormat={}{0:0}%}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                  <TextBlock Grid.Row="2" Text="动画曲线" VerticalAlignment="Center" />
                  <ComboBox x:Name="MotionEasing" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Height="34">
                    <ComboBoxItem Content="平滑 · Cubic" Tag="cubic" />
                    <ComboBoxItem Content="利落 · Quintic" Tag="quintic" />
                    <ComboBoxItem Content="柔和 · Sine" Tag="sine" />
                    <ComboBoxItem Content="匀速 · Linear" Tag="linear" />
                  </ComboBox>
                </Grid>
                <TextBlock Text="操作立即执行，关闭动画不等待命令完成。遵循 Windows 的动画与辅助功能设置。" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0" />
              </StackPanel>
            </Border>
            <Border Style="{StaticResource SettingsCard}" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="更多项目与分组展开" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,4" />
                <CheckBox x:Name="ExpansionAnimations" Content="平滑展开与收起，逐项淡入或滑入" IsEnabled="{Binding ElementName=Animations, Path=IsChecked}" />
                <Grid Margin="0,8,0,0" IsEnabled="{Binding ElementName=ExpansionAnimations, Path=IsChecked}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="显示更多项目" Margin="0,0,0,8" />
                    <ComboBox x:Name="MoreExpansionStyle" Height="34">
                      <ComboBoxItem Content="无动画" Tag="none" />
                      <ComboBoxItem Content="淡入" Tag="fade" />
                      <ComboBoxItem Content="轻滑动" Tag="slide" />
                      <ComboBoxItem Content="淡入 + 轻滑动" Tag="fade-slide" />
                    </ComboBox>
                    <Grid Margin="0,12,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="62" />
                      </Grid.ColumnDefinitions>
                      <Slider x:Name="MoreExpansionDuration" Minimum="60" Maximum="400" TickFrequency="10" IsSnapToTickEnabled="True" />
                      <TextBlock Grid.Column="1" Text="{Binding ElementName=MoreExpansionDuration, Path=Value, StringFormat={}{0:0} ms}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="侧边子菜单" Margin="0,0,0,8" />
                    <ComboBox x:Name="GroupExpansionStyle" Height="34">
                      <ComboBoxItem Content="无动画" Tag="none" />
                      <ComboBoxItem Content="淡入" Tag="fade" />
                      <ComboBoxItem Content="轻滑动" Tag="slide" />
                      <ComboBoxItem Content="淡入 + 轻滑动" Tag="fade-slide" />
                    </ComboBox>
                    <Grid Margin="0,12,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="62" />
                      </Grid.ColumnDefinitions>
                      <Slider x:Name="GroupExpansionDuration" Minimum="60" Maximum="400" TickFrequency="10" IsSnapToTickEnabled="True" />
                      <TextBlock Grid.Column="1" Text="{Binding ElementName=GroupExpansionDuration, Path=Value, StringFormat={}{0:0} ms}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                  </StackPanel>
                </Grid>
                <TextBlock Text="默认更多项目 220 ms、分组 180 ms，使用上方动画曲线。搜索即时更新；关闭系统动画或启用高对比度时立即展开。" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0" />
              </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal">
              <Button Content="预览当前外观与动效" Click="Preview_Click" BorderBrush="{DynamicResource AccentBrush}" />
              <Button Content="恢复默认动效" Click="ResetMotion_Click" Margin="10,0,0,0" />
            </StackPanel>
            <TextBlock Text="预览使用当前选项；按 Esc 或点击菜单外查看关闭效果。点击“保存设置”后正式生效。" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,8" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="一级菜单">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Text="勾选“一级显示”的动作直接出现在菜单中；其余动作悬停“更多项目”即在原菜单展开。顶部工具栏项目始终位于顶部。" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,12" />
          <DataGrid x:Name="BuiltinGrid" Grid.Row="1" CanUserSortColumns="False">
            <DataGrid.Columns>
              <DataGridTextColumn Header="动作" Binding="{Binding Title}" IsReadOnly="True" Width="*" />
              <DataGridTemplateColumn Header="启用" Width="80">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <CheckBox IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" Margin="0" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="一级显示" Width="100">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <CheckBox IsChecked="{Binding IsPrimary, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanPin}" HorizontalAlignment="Center" Margin="0" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="快捷键" Binding="{Binding Shortcut}" IsReadOnly="True" Width="110" />
            </DataGrid.Columns>
          </DataGrid>
          <StackPanel x:Name="BuiltinCommands" Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="上移" Click="MoveUp_Click" Margin="0,0,8,0" />
            <Button Content="下移" Click="MoveDown_Click" />
            <Button Content="预览菜单" Click="Preview_Click" Margin="14,0,0,0" />
          </StackPanel>
        </Grid>
      </TabItem>
      <TabItem Header="自定义动作">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Text="添加你常用的程序或脚本，并设置适用扩展名和多选行为。设置保存后生效。" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />
          <DataGrid x:Name="CustomGrid" Grid.Row="1">
            <DataGrid.Columns>
              <DataGridTextColumn Header="名称" Binding="{Binding Title}" IsReadOnly="True" Width="*" />
              <DataGridTemplateColumn Header="启用" Width="65">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <CheckBox IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" Margin="0" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="一级" Width="65">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <CheckBox IsChecked="{Binding IsPrimary, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" Margin="0" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="程序" Binding="{Binding Executable}" IsReadOnly="True" Width="230" />
            </DataGrid.Columns>
          </DataGrid>
          <StackPanel x:Name="CustomCommands" Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="添加动作" Click="AddCustom_Click" Margin="0,0,8,0" />
            <Button Content="编辑选中项" Click="EditCustom_Click" Margin="0,0,8,0" />
            <Button Content="移除选中项" Click="RemoveCustom_Click" />
          </StackPanel>
        </Grid>
      </TabItem>
      <TabItem Header="系统项目">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Text="这里展示最近一次识别到的系统项目。可固定到一级菜单或隐藏；菜单中也可直接点击星标。不同文件类型拥有不同项目。" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />
          <DataGrid x:Name="ShellGrid" Grid.Row="1">
            <DataGrid.Columns>
              <DataGridTextColumn Header="动作" Binding="{Binding Title}" IsReadOnly="True" Width="*" />
              <DataGridTemplateColumn Header="一级显示" Width="100">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <CheckBox IsChecked="{Binding Pinned, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" Margin="0" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="隐藏" Width="70">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <CheckBox IsChecked="{Binding Hidden, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" Margin="0" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock Grid.Row="2" Text="先在文件上呼出一次 BetterCM，再打开本页查看。无文字的自绘菜单项及部分仅支持 Win11 新菜单的扩展可能无法导入。" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0" FontSize="12" />
        </Grid>
      </TabItem>
      <TabItem Header="诊断">
        <StackPanel>
          <TextBlock Text="最近一次捕获的上下文" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12" />
          <TextBox x:Name="DiagnosticsText" IsReadOnly="True" TextWrapping="Wrap" MinHeight="170" VerticalScrollBarVisibility="Auto" />
          <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
            <Button Content="预览菜单" Click="Preview_Click" Margin="0,0,8,0" />
            <Button Content="打开用户配置" Click="OpenConfig_Click" Margin="0,0,8,0" />
            <Button Content="打开日志目录" Click="OpenLogs_Click" />
          </StackPanel>
          <TextBlock Text="诊断保留上一次捕获结果；点击设置界面不会把目标替换为 BetterCM 自己。快捷键冲突会在常规页显示。" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,18,0,0" />
        </StackPanel>
      </TabItem>
    </TabControl>
    <Grid Grid.Row="2" Margin="0,20,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="SaveStatus" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0" />
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button Content="还原为已保存" Click="RestoreSaved_Click" Margin="0,0,10,0" />
        <Button x:Name="SaveButton" Content="保存设置" Click="Save_Click" BorderBrush="{DynamicResource AccentBrush}" Margin="0,0,10,0" />
      </StackPanel>
      <Button Grid.Column="2" Content="关闭到托盘" Click="Hide_Click" />
    </Grid>
  </Grid>
</Window>
