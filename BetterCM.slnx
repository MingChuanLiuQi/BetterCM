<Solution>
  <Configurations>
    <BuildType Name="Debug" />
    <BuildType Name="Release" />
    <BuildType Name="QA" />
  </Configurations>
  <Project Path="BetterCM.csproj" />
  <Project Path="Tests/BetterCM.Tests.csproj">
    <!-- Release solution builds only ship the product. QA/Debug include the QA-dependent tests. -->
    <Build Solution="Release|*" Project="false" />
  </Project>
</Solution>
